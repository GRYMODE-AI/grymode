# Public Supabase credentials for the waitlist form (anon / publishable key only).
# Never put the service role key or Resend API key in this Vite app — those live in
# supabase/.env (local) or `supabase secrets` (hosted Edge Function).
#
# Use the same Supabase project as the Grymode API after applying:
#   supabase/migrations/20261019160000_waitlist_signups.sql
#   supabase/migrations/20261020120000_waitlist_email_backup.sql

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional override. Defaults to ${VITE_SUPABASE_URL}/functions/v1/waitlist-signup
# VITE_WAITLIST_FUNCTION_URL=http://127.0.0.1:54321/functions/v1/waitlist-signup
