# Copy to supabase/.env for local `supabase functions serve`.
# For hosted projects, set the same keys via:
#   supabase secrets set RESEND_API_KEY=re_xxx RESEND_FROM_EMAIL="Grymode AI <onboarding@resend.dev>"
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically by the
# Edge Runtime when serving/deploying — you usually do NOT put them here for hosted.
# For local functions serve they come from `supabase status`.

# Resend — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Must be a verified domain sender to email any recipient (not only your Resend login).
RESEND_FROM_EMAIL=Grymode AI <hello@grymode.com>

# When serving functions locally against hosted Supabase, use these names
# (the CLI ignores env vars that start with SUPABASE_).
# WAITLIST_SUPABASE_URL=https://xxxx.supabase.co
# WAITLIST_SERVICE_ROLE_KEY=eyJ...

# Optional: also mirror signups into a Resend Audience (Contacts).
# RESEND_AUDIENCE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Optional: CTA link inside the welcome email.
WAITLIST_SITE_URL=https://grymode.ai

# Contact form destination (admin inbox).
CONTACT_TO_EMAIL=hello@grymode.com
