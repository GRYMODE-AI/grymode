# Copy to .env for local runs (.env is gitignored). Values below are for the local
# Supabase stack only; run `supabase status` from the repository root to see them.
# Deployed environments receive these from Google Secret Manager, never from files.
GRYMODE_ENVIRONMENT=development
GRYMODE_SUPABASE_URL=http://127.0.0.1:54321
GRYMODE_SUPABASE_SECRET_KEY=paste-SECRET_KEY-from-supabase-status
GRYMODE_DATABASE_URL=postgresql://grymode_api:grymode-local-dev-only@127.0.0.1:54322/postgres

# AI provider (backend only — never in the iOS app). Model IDs must appear in
# `GET https://api.openai.com/v1/models` for your project key.
GRYMODE_AI_PROVIDER=openai
GRYMODE_AI_API_KEY=sk-proj-REPLACE-WITH-YOUR-OPENAI-PROJECT-KEY
GRYMODE_AI_VISION_MODEL=REPLACE-WITH-VISION-MODEL-ID
GRYMODE_AI_OUTFIT_MODEL=gpt-6-astra
# Look visuals + personal try-on renders (ADR 0012)
GRYMODE_AI_IMAGE_MODEL=gpt-image-2.5-sunburst
GRYMODE_AI_IMAGE_QUALITY=high
# Cost controls: never auto-render after generate; clients request POST /v1/outfits/{id}/visual
GRYMODE_AI_RENDER_LOOKS_AFTER_GENERATION=false
# Daily/monthly caps for newly billed look visuals and try-on angles (cache hits are free)
GRYMODE_AI_LOOK_RENDER_DAILY_FREE=3
GRYMODE_AI_LOOK_RENDER_MONTHLY_FREE=10
GRYMODE_AI_LOOK_RENDER_DAILY_PREMIUM=20
GRYMODE_AI_LOOK_RENDER_MONTHLY_PREMIUM=100
GRYMODE_AI_TRY_ON_DAILY_FREE=1
GRYMODE_AI_TRY_ON_MONTHLY_FREE=3
GRYMODE_AI_TRY_ON_DAILY_PREMIUM=10
GRYMODE_AI_TRY_ON_MONTHLY_PREMIUM=40
